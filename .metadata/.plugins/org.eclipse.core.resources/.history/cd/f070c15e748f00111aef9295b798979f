spring.application.name=healbit

server.port=8080

#  MySQL Datasource
#  createDatabaseIfNotExist=true auto-creates the schema on first run
spring.datasource.url=jdbc:mysql://localhost:3306/healbit_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=root
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

#  JPA / Hibernate
#  ddl-auto=update for development; switch to "validate" or "none" in production
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# Ensures Hibernate creates/updates tables (ddl-auto=update) BEFORE data.sql runs, so the
# specializations seed data below can insert into a table that already exists.
spring.jpa.defer-datasource-initialization=true

# By default Spring Boot only auto-runs data.sql for EMBEDDED databases (H2 etc). Since this
# project uses MySQL, that default would silently skip data.sql — this forces it to always run.
spring.sql.init.mode=always

# Dialect is auto-detected on Spring Boot 3 / Hibernate 6; uncomment only if needed:
# spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

#  JWT (read by JwtService via @Value)
#  Secret MUST be at least 32 characters for HS256. expiration = 24h in ms.
# ------------------------------------------------------------
jwt.secret=HealBitSuperSecretKeyForJwtSigning_ChangeThisInProduction_2026
jwt.expiration=86400000

# ------------------------------------------------------------
#  Default admin seeded on startup (read by AdminInitializer)
# ------------------------------------------------------------
healbit.admin.email=admin@healbit.com
healbit.admin.password=Admin@123

# ------------------------------------------------------------
#  Google reCAPTCHA v2 (read by CaptchaService)
#  Defaults are Google's official TEST keys (always pass). Replace with your real
#  keys for production, and set the matching site key on the frontend
#  (VITE_RECAPTCHA_SITE_KEY). Set enabled=false to bypass captcha entirely.
# ------------------------------------------------------------
google.recaptcha.enabled=true
google.recaptcha.secret=6LeYHGgtAAAAAJo6MHrM7FCZKzPxzi5P5JO1dE8r
google.recaptcha.verify-url=https://www.google.com/recaptcha/api/siteverify

# ------------------------------------------------------------
#  File uploads (patient documents) — read by FileStorageService
#  Files are stored on disk under healbit.uploads.dir; only metadata goes in the DB.
# ------------------------------------------------------------
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=12MB
healbit.uploads.dir=uploads/patient-documents

# ------------------------------------------------------------
#  Razorpay (test mode) — read by RazorpayService
#  Key id is also exposed to the frontend (public); key secret stays here only.
# ------------------------------------------------------------
razorpay.key-id=rzp_test_TLIkxqiognIgp2
razorpay.key-secret=NBh2ySBYyM1k4RxA9J9fxQQI

# ------------------------------------------------------------
#  Appointment booking rules & housekeeping
# ------------------------------------------------------------
# Max live (pending + confirmed) appointments one patient may hold at a time
healbit.booking.max-open-per-patient=5

# How far ahead a patient may book
healbit.booking.max-days-ahead=90

# How long an unpaid ONLINE booking may hold its slot before it is released
healbit.booking.online-hold-minutes=10

# Sweep intervals in ms (hold release / expiry of un-actioned appointments)
healbit.booking.hold-sweep-ms=300000
healbit.booking.expiry-sweep-ms=1800000

# Clock used for appointment dates and times
healbit.timezone=Asia/Kolkata