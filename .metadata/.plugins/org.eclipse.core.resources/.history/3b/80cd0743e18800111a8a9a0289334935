spring.application.name=healbit

server.port=8080

# ------------------------------------------------------------
#  MySQL Datasource
#  createDatabaseIfNotExist=true auto-creates the schema on first run
# ------------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3306/healbit_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=root
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ------------------------------------------------------------
#  JPA / Hibernate
#  ddl-auto=update for development; switch to "validate" or "none" in production
# ------------------------------------------------------------
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false
# Ensures Hibernate creates/updates tables (ddl-auto=update) BEFORE data.sql runs, so the
# specializations seed data below can insert into a table that already exists.
spring.jpa.defer-datasource-initialization=true
# By default Spring Boot only auto-runs data.sql for EMBEDDED databases (H2 etc). Since this
# project uses MySQL, that default would silently skip data.sql — this forces it to always run.
spring.sql.init.mode=always
# Dialect is auto-detected on Spring Boot 3 / Hibernate 6; uncomment only if needed:
# spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# ------------------------------------------------------------
#  JWT (read by JwtService via @Value)
#  Secret MUST be at least 32 characters for HS256. expiration = 24h in ms.
# ------------------------------------------------------------
jwt.secret=HealBitSuperSecretKeyForJwtSigning_ChangeThisInProduction_2026
jwt.expiration=86400000

# ------------------------------------------------------------
#  Default admin seeded on startup (read by AdminInitializer)
# ------------------------------------------------------------
healbit.admin.email=admin@healbit.com
healbit.admin.password=Admin@123
